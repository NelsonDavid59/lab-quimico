@model AgroLaboratorio.ViewModels.UsersVMS.RegistrationVM;

<form asp-controller="Users" asp-action="Register" method="post">
    <div class="mb-3">
        <label class="form-label">Username:</label>
        <input class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Password:</label>
        <input class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Confirmación:</label>
        <input class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Nombre:</label>
        <input class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Perfil de Usuario:</label>
    </div>

    <div class="mb-3 d-grid">
        <button type="submit" class="btn btn-secondary">Registrar</button>
    </div>
    
</form>
