@model AgroLaboratorio.ViewModels.UsersVMS.LoginVM;


<form asp-controller="Users" asp-action="Login" class="login-form" method="post">
    <div class="mb-3">
        <label class="form-label">Usuario:</label>
        <input asp-for="Username" class="login-form__input form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Contraseña:</label>
        <input asp-for="Password" class="login-form__input form-control" />
    </div>
    <div class="mb-3 d-grid">
        <button type="submit" class="btn btn-success">Iniciar Sesión</button>
    </div>
</form>