<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AgroLaboratorio</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AgroLaboratorio.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="/media/images/Logo-ITL.png" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        @{
                            if (User.Identity.IsAuthenticated)
                            {
                                <li class="nav-item">
                                    <form asp-controller="Users" asp-action="Logout" method="post">
                                        <button type="submit" class="btn btn-link">Cerrar Sesión</button>
                                    </form>
                                </li>
                            }
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="content-wrapper">
        <!-- Sidebar -->
        <aside class=" sidebar">
            <h5>Menú</h5>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Users" asp-action="Index">Usuarios</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Perfils" asp-action="Index">Perfiles</a>
                </li>
                <li class="nav-item"><link href="~/css/site.css" rel="stylesheet" />
                    <a class="nav-link" asp-controller="ElemQuimicos" asp-action="Index">Elementos Químicos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Personas" asp-action="Index">Personas</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="SolsAnalisis" asp-action="Index">Solicitudes de Analisis</a>
                </li>
            </ul>
        </aside> 

        
        
        <!-- /#sidebar-wrapper -->

        <!-- Contenido principal -->
        <main class="px-4">
            @RenderBody()
        </main>

    </div>

    <!-- MODAL PARA EL LOV -->
    <div class="modal fade modal-lov" id="mainLovModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
         aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="lov-form input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <div class="form-floating">
                            <input id="filtroCampoInput" data-search-field=""
                                   class="form-control" placeholder=""
                                   disabled />
                            <label for="filtroCampoInput">Campo de Búsqueda</label>
                        </div>
                    </div>

                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    
                    <div class="table-responsive" style="max-height: 70vh; overflow-y:auto;">
                        <table class="table table-hover">
                            <thead class="table-light sticky-top">
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="minimal-pagination">
                            <button type="button" class="btn-prev-page">← Anterior</button>
                            <span class="lov-pager-info"></span>
                            <button type="button" class="btn-next-page">Siguiente →</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <template id="lovPagerInfo">
            Página <strong>__currentPage__</strong> de <strong>__pageCount__</strong>
        </template>
    </div>
    <footer class="border-top text-muted">
        <div class="container">
            &copy; 2025 - AgroLaboratorio
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/npm/imask/imask.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
