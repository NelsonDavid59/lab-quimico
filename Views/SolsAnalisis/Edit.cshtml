@using AgroLaboratorio.Utils;
@model AgroLaboratorio.ViewModels.SolsAnalisis.SolAnalisisVM;

<div class="view-wrapper container">
	<h5>Edición de Solicitud de Análisis</h5>
	<form id="formEditSolAnalisis"
		asp-controller="SolsAnalisis" asp-action="Edit" method="put"
		class="d-flex flex-column">
		<hr />

		<input asp-for="CodAnalisis" type="hidden" />

		<div class="container">
			@{
				await Html.RenderPartialAsync(FormNames.FormPartial);
			}
		</div>

		<div class="table-container">
			<hr />

			<div class="table-wrapper">
				@{
					await Html.RenderPartialAsync("_DetsForm", Model);
				}
			</div>
			<!-- /table-wrapper -->
		</div>
		<!-- /table-responsive -->

		<div class="mb-3">
			<button type="submit" class="btn btn-secondary">Actualizar</button>
		</div>
	</form>
</div>

<template id="templateFilaDet">
	@{
		await Html.RenderPartialAsync(
			"_DetailRowTemplate",
			null,
			new ViewDataDictionary(ViewData)
			{
				{ "Index", null }, {"OrderNum", null}
			}
		);
	}
</template>

@section Styles {
	<link rel="stylesheet" href="~/css/SolsAnalisis/Create.css" />
}

@section Scripts {
	<script>
		window.formConfig = @Html.Raw(Json.Serialize(new { initialTableIndex =  Model.Detalles?.Count ?? 0 }));
	</script>

	<script src="~/js/SolsAnalisis/edit.js" type="module" defer></script>

	<script src="~/js/SolsAnalisis/form.js" type="modeule" defer></script>

	@if (ViewBag.DetailsErrorScript != null)
	{
		<script type="module">
			@Html.Raw(ViewBag.DetailsErrorScript)
		</script>
	}
}