@using AgroLaboratorio.Utils
@model AgroLaboratorio.ViewModels.SolsAnalisis.SolAnalisisVM

<div class="view-wrapper container">
	<h5>Formulario de Solicitud Análisis</h5>
	<form asp-controller="SolsAnalisis" id="formCreate" asp-action="Create" method="post" 
		class="d-flex flex-column">
		<hr />
		<div class="container">
			@{
				await Html.RenderPartialAsync(FormNames.FormPartial);
			}
		</div>

		<div class="table-container">
			<hr />

			<div class="table-wrapper">
				@{
					await Html.RenderPartialAsync("_DetsForm", Model);
				}
			</div>
			<!-- /table-wrapper -->
		</div>
		<!-- /table-responsive -->

		<div class="mb-3">
			<button type="submit" class="btn btn-secondary">Guardar</button>
		</div>
	</form>
</div>


<template id="templateFilaDet">
	@{
		await Html.RenderPartialAsync("_DetailRowTemplate", 
					null, 
					new ViewDataDictionary(ViewData) { 
						{ "Index", null },
					} );
	}
</template>

@section Styles {
	<link rel="stylesheet" href="~/css/SolsAnalisis/Create.css" />
}

@section Scripts {
	<script src="~/js/SolsAnalisis/create.js" type="module"></script>

	@if (ViewBag.DetailsErrorScript != null)
	{
		<script type="module">
			@Html.Raw(ViewBag.DetailsErrorScript)
		</script>
	}
}